# The blog was called the Journal until 22 Nov 2026. Old links and the old feed keep working.
/journal /blog/ 301
/journal/* /blog/:splat 301
# Shanghai Jinghe was listed as a clone maker until 26 Nov 2026 (timegrapher#2304). Its pages kept their calibre names.
/calibres/shanghai-jinghe-clone/* /calibres/shanghai-jinghe/:splat 301
/calibres/clone-maker-not-named/* /calibres/shanghai-jinghe/:splat 301
{{- /* A calibre renamed in the app's table keeps its old address. */}}
{{ with resources.Get "calibres/export.json" }}{{ range (transform.Unmarshal .).calibres }}{{ $to := .path }}{{ range .former_paths }}
{{ . }} {{ $to }} 301{{ end }}{{ end }}{{ end }}
